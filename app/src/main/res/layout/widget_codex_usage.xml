<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_cyber"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- 给右上角绝对定位的刷新按钮预留空间，不让文字挤压按钮。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="43dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="CODEX"
            android:textColor="#FFF4F0FA"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.07" />

        <TextView
            android:id="@+id/widget_compact_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="5小时 -- · 每周 --"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFE6D3B4"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_usage_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/widget_quota_card_bg">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5 小时"
                    android:textColor="#FFD6CBDD"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_five_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFF7E8CA"
                    android:textStyle="bold"
                    android:textSize="23sp"
                    android:singleLine="true" />

                <ProgressBar
                    android:id="@+id/widget_five_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFD9CBAF"
                    android:progressBackgroundTint="#554C4658" />

                <TextView
                    android:id="@+id/widget_five_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="重置 --"
                    android:textSize="9sp"
                    android:textColor="#FFC3B7CC"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/widget_quota_card_bg">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="每周"
                    android:textColor="#FFD6CBDD"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_week_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFF7E8CA"
                    android:textStyle="bold"
                    android:textSize="23sp"
                    android:singleLine="true" />

                <ProgressBar
                    android:id="@+id/widget_week_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFD9CBAF"
                    android:progressBackgroundTint="#554C4658" />

                <TextView
                    android:id="@+id/widget_week_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="重置 --"
                    android:textSize="9sp"
                    android:textColor="#FFC3B7CC"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="本地缓存 · 等待同步"
            android:textSize="9sp"
            android:textColor="#FFA99FAF" />
    </LinearLayout>

    <!-- 独立于竖向额度内容，固定在卡片右上角，小尺寸也不会换行掉落。 -->
    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="36dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:background="@drawable/widget_refresh_bg"
        android:text="↻"
        android:textSize="23sp"
        android:textColor="#FFE9D6AF"
        android:contentDescription="刷新 Codex 用量" />
</FrameLayout>
